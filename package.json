{
  "name": "dynamic-nim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate.js",
    "build": "vite build",
    "build:pages": "vite build --base=/dynamic-nim/",
    "deploy:pages": "npm run build:pages && npx --yes gh-pages@6.3.0 -d dist -b gh-pages", 
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm test && npm run validate && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0"
  }
}
